  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 80px;
  height: 100px;
  background-image: url("https://64.media.tumblr.com/e5d565d5d2feeb27253888aaa24dacf0/13984f2e5482bc10-e6/s500x750/01cf20dcf523b6d1f03440807103b5b498beb7aa.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: "𝔇𝔯𝔦𝔳𝔢𝔯 𝔭𝔦𝔠𝔨𝔰 𝔱𝔥𝔢 𝔪𝔲𝔰𝔦𝔠, 𝔰𝔥𝔬𝔱𝔤𝔲𝔫 𝔰𝔥𝔲𝔱𝔰 𝔥𝔦𝔰 𝔠𝔞𝔨𝔢𝔥𝔬𝔩𝔢";
